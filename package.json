{
  "name": "mojarreria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "react-server-dom-webpack": "19.0.2"
    }
  },
  "scripts": {
    "build": "npm --prefix ./apps/api install --include=dev && npm --prefix ./apps/api run build",
    "start": "npm --prefix ./apps/api run start",
    "dev": "bash ./scripts/dev.sh",
    "dev:lan": "bash ./scripts/dev-lan.sh",
    "dev:api": "pnpm --filter @mojarreria/api dev",
    "dev:web": "pnpm --filter @mojarreria/web dev",
    "dev:taku": "bash ./scripts/dev-taku.sh",
    "dev:taku-main": "bash ./scripts/dev-taku-main.sh",
    "dev:taku-site": "pnpm --filter @taku/site dev",
    "dev:taku-backend": "pnpm --filter @taku/backend dev",
    "dev:taku-web": "pnpm --filter @taku/site dev",
    "dev:taku-bot-web": "pnpm --filter @taku/bot-web dev",
    "dev:taku-wa-web": "pnpm --filter @taku/wa-web dev",
    "dev:taku-wa": "bash ./scripts/dev-taku-wa.sh",
    "dev:taku-bot": "bash ./scripts/dev-taku-bot.sh",
    "dev:taku-api": "pnpm --filter @taku/backend dev",
    "list:taku-services": "bash ./scripts/list-taku-services.sh",
    "check:taku-services": "bash ./scripts/check-taku-service-config.sh",
    "dev:mobile": "pnpm --filter @mojarreria/mobile start",
    "seed:taku-wa-superowner": "pnpm --filter @mojarreria/wa-service seed:standalone-superowner",
    "seed:products": "pnpm --filter @mojarreria/api run seed:products",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
