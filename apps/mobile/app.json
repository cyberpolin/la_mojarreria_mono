{
  "expo": {
    "name": "MOJARRERIA",
    "slug": "mojarreria-mobile",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/favicon.png",
    "scheme": "mojarreria",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "adaptiveIcon": {
        "image": "./assets/images/taku.png",
        "backgroundColor": "#f9703e",
        "imageWidth": 512,
        "imageHeight": 512
      },
      "package": "com.mojarreria.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/favicon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f9703e"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MOJARRERIA usa la cámara para evidencias del cierre: baño, comedor y basura.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "kondo-soft",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {}
    },
    "ios": {
      "bundleIdentifier": "com.mojarreria.mobile"
    }
  }
}
