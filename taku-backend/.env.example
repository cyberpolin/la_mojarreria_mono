PORT=4000
HOST=0.0.0.0
# development creates the internal super admin plus demo client/system data.
# TEST also creates the same demo client/system data.
TAKU_BACKEND_ENV=development
TAKU_BACKEND_DATA_FILE=./data/taku-backend.json
TAKU_BACKEND_JWT_SECRET=replace-with-long-random-secret
TAKU_BACKEND_ADMIN_JWT_SECRET=replace-with-long-random-admin-secret
TAKU_BACKEND_REFRESH_SECRET=replace-with-long-random-refresh-secret
TAKU_BACKEND_ADMIN_REFRESH_SECRET=replace-with-long-random-admin-refresh-secret
TAKU_BACKEND_ALLOWED_ORIGINS=http://localhost:3006,http://localhost:3003

TAKU_WA_BASE_URL=https://api.wa.taku.lat
TAKU_WA_API_KEY=replace-with-wa-service-api-key
TAKU_WA_WEBHOOK_SECRET=replace-with-wa-webhook-secret

BOT_SERVICE_BASE_URL=https://bot.taku.lat
BOT_SERVICE_API_KEY=replace-with-bot-service-api-key
BOT_SERVICE_WEBHOOK_SECRET=replace-with-bot-webhook-secret
